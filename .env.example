# =====================================================
# CHRP Song Intelligence (Analyzer) — environment contract
# =====================================================
# Names only. Never commit real values.

# --- Supabase (identity + entitlement store) ---------
# Same platform as chrp-athlete-engine. The service-role key is server-only
# and must never be exposed to the browser.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Stripe (payments) -------------------------------
# Price IDs are created in the Stripe Dashboard, not from code.
# Song Intelligence must resolve to $19.00 USD one-time.
# Creator Intelligence must resolve to $149.00 USD one-time.
# A mismatch fails checkout rather than charging an unapproved amount.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_SONG_INTELLIGENCE_PRICE_ID=
STRIPE_CREATOR_INTELLIGENCE_PRICE_ID=

# --- Report generation -------------------------------
# Server-only. Required for real paid Song Intelligence in production.
ANTHROPIC_API_KEY=

# Server-only ESCAPE HATCH. Serves fixture prose as the paid product.
# MUST remain unset in production — with it unset, a production environment
# that cannot generate a real report fails closed instead of shipping a
# hard-coded fixture as freshly generated intelligence.
# CHRP_ALLOW_FIXTURE_REPORTS=

# --- Site ---------------------------------------------
# Absolute origin used to build Stripe success/cancel URLs.
NEXT_PUBLIC_SITE_URL=

# --- Existing engine integrations (unchanged) --------
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_MARKET=
SOUNDCHARTS_APP_ID=
SOUNDCHARTS_API_KEY=

# --- ElevenLabs Dr. Rhodes voice ---------------------
# Server-only. Powers the "Hear Dr. Rhodes" moment inside the paid report by
# minting short-lived signed conversation URLs against the existing private
# ConvAI agent. The permanent key MUST NEVER be exposed as NEXT_PUBLIC_* —
# the browser only ever sees the temporary WebSocket handshake URL.
ELEVENLABS_API_KEY=
# The existing production Dr. Rhodes agent id. Optional: the server falls
# back to the canonical id when unset, but the env var is the deploy contract.
ELEVENLABS_RHODES_AGENT_ID=vv1j1yrAGF0RdxJOSGIJ

# --- Flags --------------------------------------------
# NEXT_PUBLIC_MODE=demo|production
# NEXT_PUBLIC_BETA_MODE=false disables the demo checkout form
# CHRP_ALLOW_FIXTURE_REPORTS=true permits fixture prose to be served as the
#   paid report IN PRODUCTION. Leave unset unless a demo deployment is
#   explicitly intended: otherwise production refuses to pass a fixture off
#   as freshly generated Song Intelligence.
